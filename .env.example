# Copy this file to ".env" (same folder as fetch.py) and paste your free keys.
# Never upload .env to GitHub - it's already in .gitignore.

# Pexels: https://www.pexels.com/api/  (free, 200 requests/hour)
PEXELS_API_KEY=

# Pixabay: https://pixabay.com/api/docs/  (free, 100 requests/minute; key shown on that page once logged in)
PIXABAY_API_KEY=

# Optional: your email or channel URL. Wikimedia asks scripts to identify themselves politely.
BROLL_CONTACT=

# Optional: Openverse works without a key. Only set this if you registered for a token.
OPENVERSE_TOKEN=
